FROM cloudflare/cloudflared:latest AS cloudflared

FROM looplj/axonhub:v1.0.0-beta12

USER root

RUN apk update && \
    apk upgrade zlib && \
    apk add --no-cache tini && \
    rm -rf /var/cache/apk/*

COPY --from=cloudflared \
    /usr/local/bin/cloudflared \
    /usr/local/bin/cloudflared

RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -u' \
    '' \
    'if [ -z "${TUNNEL_TOKEN:-}" ]; then' \
    '    echo "错误：未设置 TUNNEL_TOKEN 环境变量" >&2' \
    '    exit 1' \
    'fi' \
    '' \
    'echo "正在启动 AxonHub..."' \
    '/app/axonhub &' \
    'APP_PID=$!' \
    '' \
    'echo "正在启动 Cloudflare Tunnel..."' \
    'cloudflared tunnel --no-autoupdate --protocol http2 run &' \
    'TUNNEL_PID=$!' \
    '' \
    'cleanup() {' \
    '    trap - INT TERM EXIT' \
    '    kill -TERM "$APP_PID" "$TUNNEL_PID" 2>/dev/null || true' \
    '    wait "$APP_PID" 2>/dev/null || true' \
    '    wait "$TUNNEL_PID" 2>/dev/null || true' \
    '}' \
    '' \
    'trap cleanup INT TERM EXIT' \
    '' \
    'while kill -0 "$APP_PID" 2>/dev/null && kill -0 "$TUNNEL_PID" 2>/dev/null; do' \
    '    sleep 2' \
    'done' \
    '' \
    'echo "AxonHub 或 Cloudflare Tunnel 已停止" >&2' \
    'exit 1' \
    > /usr/local/bin/start.sh && \
    chmod 755 /usr/local/bin/start.sh

USER 10014

EXPOSE 8090

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/start.sh"]
